# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
.venv_test/
venv/
*.egg-info/
dist/
build/
.eggs/

# 本地 SQLite（CM 架构下各服务共享的本地数据文件，含 WAL 边车文件）
data/
*.db
*.db-wal
*.db-shm

# Node.js
node_modules/
dist/
*.js.map

# frontend/src 是纯 TypeScript 源码；tsconfig.json 已加 noEmit 防止 `tsc` 把编译产物
# 直接吐在源码目录里（历史上曾经这样误提交过 64 个 .js 影子文件），这里再兜底一层
frontend/src/**/*.js
*.d.ts

# Environment
.env
.env.local
.env.*.local

# Docker
.docker/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Runtime artifacts
/tmp/pi-sandbox/
docs/*
!docs/assets/
!docs/assets/system-architecture.png
!docs/assets/agentic-rag-sequence.png

# Electron 打包产物（electron/src、package.json、tsconfig.json 等源码仍需追踪）
electron/release/
electron/build-assets/

# PyInstaller 构建 cm-server 时的临时虚拟环境与生成的 spec 文件
# （scripts/build-*.sh 汇总产物目录 /build/ 与 cm-server/{build,dist}/ 已被顶部通用的
# build/、dist/ 规则忽略，无需重复声明）
cm-server/.pyinstaller-venv/
cm-server/*.spec
arxiv-mcp/.pyinstaller-venv/
arxiv-mcp/*.spec
nature-mcp/.pyinstaller-venv/
nature-mcp/.venv/
nature-mcp/*.spec
