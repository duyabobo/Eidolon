;; onenew macOS 沙盒 Seatbelt Profile（整 pi 进程 + bash 子进程继承）。
;;
;; 两层模型中的「层 1」内核边界：
;;   - (allow default) 保证工具链可用（deny-default 在 macOS 上对 bash/python 极易 SIGABRT）
;;   - 禁止读写宿主 /Users、/Volumes 下任意路径，除非显式白名单叶子
;;   - 禁止读写 SANDBOX_ROOT 下其他 session/用户数据
;;   - 网络默认拒绝，仅放行本 session 的 llm/mcp 桥
;;
;; 「层 2」应用层 workspace jail 见 extensions/bwrap/index.ts 的 guardPath。
;;
;; 注意：sandbox-exec 不可嵌套（子进程再 sandbox-exec 会 Operation not permitted），
;; 因此代码执行隔离依赖本 profile 被 bash 继承，而不是二次套壳。
;;
;; ⚠️ /tmp、/var、/etc 在 macOS 上是 /private/... 符号链接，占位符必须传 realpath。
;; ⚠️ 必须放行 /dev 写，否则重定向 /dev/null 失败。
;; ⚠️ file-read* 拒绝 /Users 时必须 literal 放行白名单路径的祖先目录，否则 realpath/getcwd EPERM。

(version 1)
(allow default)

;; ── 文件写入：仅白名单可写 ──────────────────────────────────────────────────
(allow file-write* (subpath "/dev"))

(deny file-write*
  (require-all
    (require-not (subpath "{{WORKSPACE}}"))
    (require-not (subpath "{{HOME}}"))
    (require-not (subpath "{{SESSION_TMP}}"))
    (require-not (subpath "{{USER_PI_SESSIONS}}"))
    (require-not (subpath "{{USER_FILES}}"))
    (require-not (subpath "{{PI_CONFIG_DIR}}"))
    (require-not (subpath "/dev"))))

;; ── 文件读取：SANDBOX_ROOT 内隐藏其他 session/用户 ──────────────────────────
(deny file-read*
  (require-all
    (subpath "{{SANDBOX_ROOT}}")
    (require-not (subpath "{{WORKSPACE}}"))
    (require-not (subpath "{{HOME}}"))
    (require-not (subpath "{{SESSION_TMP}}"))
    (require-not (subpath "{{USER_PI_SESSIONS}}"))
    (require-not (subpath "{{USER_FILES}}"))
    (require-not (subpath "{{GLOBAL_SKILLS}}"))
    (require-not (subpath "{{USER_SKILLS}}"))
    (require-not (subpath "{{PI_CONFIG_DIR}}"))
{{SANDBOX_READ_ANCESTOR_EXCEPTIONS}}))

;; ── 文件读取：宿主用户目录 / 外置卷默认不可读（层 1 核心）────────────────────
;; 阻止 bash/python/cat 直接读 ~/CLAUDE.md、Documents 等；仅放行本 session 白名单。
;; 例外列表（叶子 subpath + 祖先 literal）由 sandbox-macos.ts 渲染进 HOST_USER_READ_EXCEPTIONS。
(deny file-read*
  (require-all
    (require-any
      (subpath "/Users")
      (subpath "/Volumes"))
{{HOST_USER_READ_EXCEPTIONS}}))

;; ── 网络：{{NETWORK_MODE_COMMENT}} ────────────────────────────────────────
{{NETWORK_RULES}}
