# ===== MongoDB =====
MONGO_URI=mongodb://mongo:27019
MONGO_DB=pi_agent

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== Gateway（会话 CRUD / 任务派发，按 QPS 扩容）=====
GATEWAY_PORT=8002
GATEWAY_HOST=0.0.0.0

# ===== Gateway-SSE（SSE 长连接，按并发连接数独立扩容）=====
GATEWAY_SSE_PORT=8001
GATEWAY_SSE_HOST=0.0.0.0

# ===== Admin =====
ADMIN_PORT=9000
ADMIN_HOST=0.0.0.0

# 知识库 mRAG（前端「本地 / 线上 / 测试」环境对应地址）
# admin/gateway 在容器内访问宿主机 mRAG，需用 host.docker.internal（宿主机直跑才用 127.0.0.1）
KNOWLEDGE_LOCAL_BASE_URL=http://host.docker.internal:9621
# KNOWLEDGE_PROD_BASE_URL=http://www.scienceone.cn/mrag-knowledge
# KNOWLEDGE_TEST_BASE_URL=http://1.92.211.130:38026/mrag-knowledge

# ===== Pi Runtime =====
# pi-runtime 只需指向我们的 llm-proxy，不直接接触上游 Provider
OPENAI_BASE_URL=http://llm-proxy:9001/v1
OPENAI_API_KEY=pi-agent-internal

# bwrap 沙盒根目录（容器内路径）
# 结构：{SANDBOX_ROOT}/users/{user_id}/workspace/  → 持久化
#        {SANDBOX_ROOT}/users/{user_id}/home/       → 持久化
#        {SANDBOX_ROOT}/users/{user_id}/sessions/{sid}/tmp/ → 临时
SANDBOX_ROOT=/data/sandboxes

# bwrap 沙盒是否允许联网：true=可联网，false=不可联网
SANDBOX_NETWORK_ENABLED=false

# ===== 生产集群共享存储（docker-compose.prod.yml 使用）=====
# NFS 自建
NFS_SERVER_ADDR=192.168.1.100
NFS_EXPORT_PATH=/data/pi-sandboxes

# AWS EFS（与 NFS 二选一）
# EFS_DNS_NAME=fs-xxxxxxxx.efs.ap-east-1.amazonaws.com

# 阿里云 NAS（与 NFS 二选一）
# NAS_SERVER_ADDR=xxxxxxxx.nas.aliyuncs.com
# NAS_EXPORT_PATH=/
