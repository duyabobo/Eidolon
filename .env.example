# ===== 本地 SQLite（cm-server 合并的 gateway/gateway-sse/admin/llm-proxy/mcp-proxy
# 五个模块共享同一个文件，替代原 MongoDB + Redis：MongoDB 承载数据，Redis Stream/Pub-Sub
# 承载任务队列与 SSE 增量输出，均已迁移到本地 SQLite + 进程内事件总线，
# 不再需要外部数据库/消息中间件）=====
# 默认取仓库根目录下 data/local.db，一般无需配置
# SQLITE_PATH=/data/local.db

# ===== CM Server（合并自 gateway/gateway-sse/admin/llm-proxy/mcp-proxy，单进程单端口）=====
CM_SERVER_PORT=8000
CM_SERVER_HOST=0.0.0.0
# pi-runtime 直连地址：任务派发（原 Redis Stream）与 cancel/close 控制信号（原 Redis Pub/Sub）
PI_RUNTIME_BASE_URL=http://pi-runtime:8090

# 知识库流水线 / 意图识别 / 学术检索等小模型与工具，一律由工具市场提供，不再在底座里配置

# ===== Pi Runtime =====
# pi-runtime 只需指向 cm-server 内合并的 llm-proxy 模块，不直接接触上游 Provider
OPENAI_BASE_URL=http://cm-server:8000/v1
OPENAI_API_KEY=pi-agent-internal

# 本机 HTTP 服务端口：接收 gateway 派发的任务与 cancel/close 控制信号
PI_RUNTIME_PORT=8090
# 反向调用 gateway（session 状态/events_snapshot/skill 列表）与 gateway-sse（推送增量事件）
# 二者已合并进 cm-server，同一个地址
GATEWAY_BASE_URL=http://cm-server:8000
GATEWAY_SSE_BASE_URL=http://cm-server:8000

# bwrap 沙盒根目录（容器内路径）
# 结构：{SANDBOX_ROOT}/users/{user_id}/workspace/  → 持久化
#        {SANDBOX_ROOT}/users/{user_id}/home/       → 持久化
#        {SANDBOX_ROOT}/users/{user_id}/sessions/{sid}/tmp/ → 临时
SANDBOX_ROOT=/data/sandboxes

# bwrap 沙盒是否允许联网：true=可联网，false=不可联网
SANDBOX_NETWORK_ENABLED=false

